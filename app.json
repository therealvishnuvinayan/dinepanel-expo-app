{
  "expo": {
    "name": "DinePanel Customer",
    "slug": "dinepanel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/dinepanel-app-icon-1024.png",
    "scheme": "dinepanel",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.dinepanel.customer",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F3D2E",
        "foregroundImage": "./assets/brand/dinepanel-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/dinepanel-mark-64.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DinePanel to scan secure restaurant reward codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/dinepanel-logo-horizontal-1600.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F1"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
