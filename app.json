{
  "expo": {
    "name": "DinePanel",
    "slug": "dinepanel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dinepanel-icon.png",
    "scheme": "dinepanel",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EAF7F0",
        "foregroundImage": "./assets/images/dinepanel-foreground.png",
        "monochromeImage": "./assets/images/dinepanel-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/dinepanel-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DinePanel to scan secure restaurant reward codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dinepanel-splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
